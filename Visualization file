import matplotlib.pyplot as plt
import pandas as pd


def generate_graphs(recipes):
    """
    Generates:
    1. Recipes vs Health Score
    2. Recipes vs Number of Steps
    3. Recipes vs Health Level
    """

    if not recipes:
        print("No recipes to visualize.")
        return

    titles = [r.title for r in recipes]
    health_scores = [r.health_score for r in recipes]
    num_steps = [r.num_steps for r in recipes]
    health_levels = [r.health_level for r in recipes]

    # -------------------------------
    # GRAPH 1: Recipes vs Health Score
    # -------------------------------
    plt.figure()
    plt.bar(titles, health_scores)
    plt.xticks(rotation=45, ha='right')
    plt.title("Recipes vs Health Score")
    plt.ylabel("Health Score")
    plt.tight_layout()
    plt.show()

    # -------------------------------
    # GRAPH 2: Recipes vs Number of Steps
    # -------------------------------
    plt.figure()
    plt.bar(titles, num_steps)
    plt.xticks(rotation=45, ha='right')
    plt.title("Recipes vs Number of Steps")
    plt.ylabel("Number of Steps")
    plt.tight_layout()
    plt.show()

    # -------------------------------
    # GRAPH 3: Recipes vs Health Level
    # -------------------------------
    plt.figure()
    plt.bar(titles, health_levels)
    plt.xticks(rotation=45, ha='right')
    plt.title("Recipes vs Health Level")
    plt.ylabel("Health Level")
    plt.tight_layout()
    plt.show()

