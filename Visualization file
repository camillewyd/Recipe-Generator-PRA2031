import pandas as pd
import matplotlib.pyplot as plt

file_path = "final_filtered_recipes.csv"   
df = pd.read_csv(file_path)

# Graph 1: Repipes vs health score 

ingredient = "chicken"   # change this to any ingredient you want

filtered_df = df[df["ingredients"].str.contains(ingredient, case=False, na=False)] # filter recepies with this ingereient 


# Select top 10 by healthiness_score

top_10 = (
    filtered_df
    .sort_values(by="healthiness_score", ascending=False)
    .drop_duplicates(subset="recipe_title")   # optional: remove duplicate titles
    .head(10)
)


# Plot Recipe vs Health Score

plt.figure(figsize=(10,6))
plt.bar(top_10["recipe_title"], top_10["healthiness_score"])

plt.xlabel("Recipe Title")
plt.ylabel("Healthiness Score")
plt.title(f"Top 10 {ingredient.capitalize()} Recipes by Healthiness Score")

plt.xticks(rotation=75)
plt.tight_layout()
plt.show()


print(top_10[["recipe_title", "healthiness_score"]])
